#!/usr/bin/guile -s
!#
;; Here is a mathematical function known as Ackermann's function:
;;
 (define (A x y)
   (cond ((= y 0) 0)
         ((= x 0) (* 2 y))
         ((= y 1) 2)
         (else (A (- x 1) (A x (- y 1))))))
